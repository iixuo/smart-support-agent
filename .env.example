# Copy to .env and fill in. .env is git-ignored — never commit real keys.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional JSON merged into each request body, e.g. to toggle thinking mode
DEEPSEEK_EXTRA_BODY=

# Agent limits
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_S=90

# Simulated "today" so evaluation results are reproducible
SIM_TODAY=2026-11-18

# Pricing in CNY per 1M tokens, deepseek-flash peak-hour rates (off-peak is half)
# https://api-docs.deepseek.com/zh-cn/quick_start/pricing
PRICE_INPUT_CACHE_HIT=0.04
PRICE_INPUT_CACHE_MISS=2
PRICE_OUTPUT=8
